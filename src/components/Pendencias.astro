---
import pendencias from "../data/pendencias.json";
---

<ul class="todo-list">
  {
    pendencias.map((item, i) => (
      <li class="todo-item">
        <input
          type="checkbox"
          id={`item-${String(i).padStart(2, "0")}`}
          disabled
          checked={item.feito}
        />
        <label
          for={`item-${String(i).padStart(2, "0")}`}
          set:html={item.texto}
        />
      </li>
    ))
  }
</ul>
