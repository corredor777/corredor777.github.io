---
// Stub de redirect: o permalink publicado /fragmentos/transmissoes/main.html
// (build format:"file") passa a apontar para o hub novo
// /fragmentos/transmissoes/. Meta refresh (sem depender de JS) + link de
// escape, no vocabulário do site.
const destino = "/fragmentos/transmissoes/";
---

<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=1200" />
    <meta http-equiv="refresh" content={`0; url=${destino}`} />
    <link rel="canonical" href={destino} />
    <title>Realocando sinal…</title>
    <style>
      body {
        margin: 0;
        height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #0a0a0a;
        color: #38ecdc;
        font-family: "JetBrains Mono", ui-monospace, monospace;
        font-size: 10pt;
        letter-spacing: 1px;
      }
      a {
        color: #ff0037;
        text-decoration: none;
      }
    </style>
  </head>
  <body>
    <p>
      SINAL REALOCADO — reconectando à transmissão…
      <a href={destino}>[ ACESSAR ]</a>
    </p>
  </body>
</html>
